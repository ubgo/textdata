{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "ds map --budget 2000",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "lore agent start --tool claude_code --hook-stdin",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "lore agent end --tool claude_code",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
